# ==============================
# LegalSetu Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ==============================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL with pgvector extension) ---
DATABASE_URL="postgresql://legalsetu:legalsetu@localhost:5432/legalsetu?schema=public"

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# --- AI Provider ---
# Set to "mock" to run the entire app in DEMO MODE with no API keys required.
# Set to "gemini" (default real provider), "groq" or "openai" to use real AI.
# NOTE: Gemini API keys may start with either "AIza" or "AQ." depending on
# when they were issued. Both are valid.
AI_PROVIDER=mock

# Optional: run answers on a fast provider while embeddings (and therefore
# vector retrieval) stay on one that supports them. Groq has no embeddings
# endpoint, so pair it with Gemini:
#   AI_PROVIDER=groq
#   EMBEDDING_PROVIDER=gemini
EMBEDDING_PROVIDER=

# Google Gemini (default real provider)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (alternate provider — OpenAI-compatible, fast, free tier).
# Supports chat/translation and Whisper speech-to-text, but has NO
# embeddings endpoint, so RAG retrieval is disabled on this provider.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# OpenAI (alternate provider — set AI_PROVIDER=openai to use this instead)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Speech-to-Text ---
STT_PROVIDER=mock
STT_API_KEY=

# --- Translation ---
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# --- OCR ---
OCR_PROVIDER=mock
OCR_API_KEY=

# --- Redis (rate limiting / caching) ---
REDIS_URL=redis://localhost:6379

# --- File Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=legalsetu-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
