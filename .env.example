# ==============================
# LegalSetu Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ==============================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL with pgvector extension) ---
DATABASE_URL="postgresql://legalsetu:legalsetu@localhost:5432/legalsetu?schema=public"

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# --- AI Provider ---
# Set to "mock" to run the entire app in DEMO MODE with no API keys required.
# Set to "gemini" (default real provider) or "openai" (alternate) to use real AI.
AI_PROVIDER=mock

# Google Gemini (default real provider)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (alternate provider — set AI_PROVIDER=openai to use this instead)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Speech-to-Text ---
STT_PROVIDER=mock
STT_API_KEY=

# --- Translation ---
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# --- OCR ---
OCR_PROVIDER=mock
OCR_API_KEY=

# --- Redis (rate limiting / caching) ---
REDIS_URL=redis://localhost:6379

# --- File Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=legalsetu-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
