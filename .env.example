# ==============================
# LegalSetu Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ==============================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public site that links inside emails point to (defaults to the URL above).
# EMAIL_LINK_BASE_URL=https://your-app.vercel.app
# Accounts that act as the fictional demo advocates (comma-separated; defaults to ADMIN_EMAIL).
# DEMO_ADVOCATE_OPERATORS=you@example.com

# --- Database (PostgreSQL with pgvector extension) ---
DATABASE_URL="postgresql://legalsetu:legalsetu@localhost:5432/legalsetu?schema=public"

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# --- AI Provider ---
# Set to "mock" to run the entire app in DEMO MODE with no API keys required.
# Set to "gemini" (default real provider), "groq" or "openai" to use real AI.
# NOTE: Gemini API keys may start with either "AIza" or "AQ." depending on
# when they were issued. Both are valid.
AI_PROVIDER=mock

# Optional: run answers on a fast provider while embeddings (and therefore
# vector retrieval) stay on one that supports them. Groq has no embeddings
# endpoint, so pair it with Gemini:
#   AI_PROVIDER=groq
#   EMBEDDING_PROVIDER=gemini
EMBEDDING_PROVIDER=

# Google Gemini (default real provider)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (alternate provider — OpenAI-compatible, fast, free tier).
# Supports chat/translation and Whisper speech-to-text, but has NO
# embeddings endpoint, so RAG retrieval is disabled on this provider.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# Local model via Ollama (optional, LOCAL ONLY - never on Vercel).
# Setting OLLAMA_BASE_URL adds "Local (Ollama)" to the model picker. It is
# never used by Auto: on a laptop CPU it takes minutes per answer.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=gemma3:1b

# Voice mode in Ollama mode needs no API key: speech is recognised by local
# Whisper (voice-local/server.py, started automatically; needs Python with
# `pip install faster-whisper`) and replies are spoken by the browser, or by
# Piper if `pip install piper-tts` and a voice is put in voice-local/voices/.
# LOCAL_STT_MODEL=small          # base = faster but poor Hindi; medium = slower
# LOCAL_VOICE_PORT=8765
# LOCAL_VOICE_AUTOSTART=1        # 0 = run `npm run voice:local` yourself
# LOCAL_VOICE_PYTHON=python

# Mistral (free "Experiment" plan: no card, phone verification only).
# Backup chat provider behind Groq. Key: console.mistral.ai -> API keys.
# On the free plan, requests may be used to train Mistral's models.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-medium-latest

# OpenAI (alternate provider — set AI_PROVIDER=openai to use this instead)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Speech-to-Text ---
STT_PROVIDER=mock
STT_API_KEY=

# --- Translation ---
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# --- OCR ---
OCR_PROVIDER=mock
OCR_API_KEY=

# --- Redis (rate limiting / caching) ---
REDIS_URL=redis://localhost:6379

# --- File Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=legalsetu-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true

# Rights Clock — daily deadline reminder job (/api/rights-clock/reminders).
# Set a long random value and send it as "Authorization: Bearer <value>".
# Leave empty to disable the endpoint.
CRON_SECRET=

# Verified Lawyer Connect
# Map tiles (must allow tile use for your traffic; OpenStreetMap's public
# servers are for light use only).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Nominatim-compatible geocoder (PIN code / place search). The public
# server allows 1 request/second — self-host or use a provider in production.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="LegalSetu/0.1 (legal-aid lawyer directory)"
# Private upload folder (verification documents, photos). Mount a volume here in Docker.
STORAGE_LOCAL_DIR=
# Password for the fictional demo advocates (npm run lawyers:seed).
DEMO_LAWYER_PASSWORD=

# ==============================
# Phone calls ("Call me" helpline)
# ==============================
# LegalSetu phones the user, asks about their problem in their language and
# explains their options aloud. Needs: a Twilio account, the voice bridge
# (npm run voice:bridge) running somewhere that can hold a WebSocket open,
# and that bridge reachable from the internet.
#
# Twilio — console.twilio.com. On a TRIAL account:
#  * TWILIO_PHONE_NUMBER must be a number the account owns (Console -> Phone
#    Numbers -> Get a trial number) or a verified caller ID. A number that is
#    merely typed in here fails with error 21210.
#  * Only numbers verified under "Verified Caller IDs" can be called.
#  * Enable India under Voice -> Geo permissions.
#  * The call starts with a short Twilio notice; press any key to continue.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public address of the bridge, e.g. a Cloudflare quick tunnel to port 8787:
#   cloudflared tunnel --url http://localhost:8787
CALL_BRIDGE_PUBLIC_URL=
# Where the bridge reaches the app (default http://localhost:3000)
CALL_APP_URL=http://localhost:3000
CALL_BRIDGE_PORT=8787
# Signs call tokens. Optional: derived from AUTH_SECRET when unset.
CALL_BRIDGE_SECRET=

# Speech. Sarvam is best for Indian languages but needs credit; without it
# calls fall back to Groq Whisper (hearing) and Gemini live voice (speaking).
#   CALL_TTS_PROVIDER=auto|live|sarvam|gemini     (default auto: live, sarvam, gemini)
#   CALL_STT_PROVIDER=auto|sarvam|groq            (default auto: sarvam, groq)
#   CALL_LIVE_MODEL=gemini-3.8-live
#   CALL_WHISPER_MODEL=whisper-large-v3
#   CALL_MAX_MINUTES / CALL_MAX_CONCURRENT        call length and simultaneous calls
# After topping up Sarvam, delete .cache/call-phrases and .cache/call-bench.json
# so the fixed phrases are re-recorded in the Sarvam voice.
