generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String          @id @default(uuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  auditLogs     AuditLog[]
  cases         Case[]
  conversations Conversation[]
  documents     Document[]
  firDrafts     FIRDraft[]
  feedback      Feedback[]
  notifications Notification[]
  sessions      Session[]
  preferences   UserPreference?
  memories      UserMemory[]
  savedSources  SavedSource[]
  referrals     LawyerReferral[]

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  interfaceLanguage String   @default("en")
  responseLanguage  String   @default("en")
  voiceLanguage     String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Case {
  id            String           @id @default(uuid())
  userId        String
  title         String
  summary       String?
  status        CaseStatus       @default(OPEN)
  jurisdiction  String?
  /// Short plain-language note on what to do next — the thing that
  /// turns a folder of chats and documents into an actual case
  /// tracker instead of an archive nobody revisits.
  nextAction    String?
  nextActionDue DateTime?
  /// Set automatically when status moves to RESOLVED or CLOSED,
  /// cleared if it is reopened.
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  documents     Document[]
  firDrafts     FIRDraft[]
  referrals     LawyerReferral[]

  @@index([userId])
  @@index([status])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  caseId    String?
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  case      Case?     @relation(fields: [caseId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([caseId])
}

model Message {
  id             String         @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  language       String         @default("en")
  evidenceLevel  EvidenceLevel?
  /// Which chat mode produced this turn: "quick" | "case" | "knowledge".
  /// Nullable so existing rows (all pre-dating multi-mode chat) remain
  /// valid; the UI treats a null mode as "quick" for display purposes.
  mode           String?
  /// For mode "case" only: "question" (the assistant is still gathering
  /// facts) or "report" (the full grounded analysis + flowchart). Null
  /// for every other mode, where a message is always a direct answer.
  kind           String?
  createdAt      DateTime       @default(now())
  citations      Citation[]
  feedback       Feedback[]
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Document {
  id            String          @id @default(uuid())
  userId        String
  caseId        String?
  title         String
  fileType      DocumentType
  storageKey    String
  sizeBytes     Int
  status        DocumentStatus  @default(UPLOADED)
  extractedText String?
  summary       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  case          Case?           @relation(fields: [caseId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]

  @@index([userId])
  @@index([caseId])
  @@index([status])
}

model DocumentChunk {
  id         String                 @id @default(uuid())
  documentId String
  text       String
  chunkIndex Int
  page       Int?
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model LegalSource {
  id                 String             @id @default(uuid())
  title              String
  actName            String?
  sourceType         SourceType
  jurisdiction       String
  language           String             @default("en")
  officialUrl        String?
  publicationDate    DateTime?
  effectiveDate      DateTime?
  version            String?
  verificationStatus VerificationStatus @default(PENDING_REVIEW)
  lastVerifiedAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  citations          Citation[]
  chunks             LegalSourceChunk[]
  savedBy            SavedSource[]

  @@index([jurisdiction])
  @@index([sourceType])
  @@index([verificationStatus])
}

model LegalSourceChunk {
  id        String                 @id @default(uuid())
  sourceId  String
  section   String?
  chapter   String?
  page      Int?
  text      String
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())
  source    LegalSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model Citation {
  id            String      @id @default(uuid())
  messageId     String
  legalSourceId String
  section       String?
  snippet       String
  createdAt     DateTime    @default(now())
  legalSource   LegalSource @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([legalSourceId])
}

model FIRDraft {
  id                String         @id @default(uuid())
  userId            String
  caseId            String?
  status            FIRStatus      @default(DRAFT)
  incidentType      String?
  incidentDate      DateTime?
  location          String?
  peopleInvolved    String?
  description       String?
  evidence          String?
  witnesses         String?
  additionalDetails String?
  /// Structured intake state (lib/fir/case-state.ts): every fact with
  /// its source and confidence, the timeline, unresolved contradictions
  /// and retrieved statutory context. The flat columns above are kept
  /// for backwards compatibility with drafts created by the old wizard.
  caseState         Json?
  /// The generated complaint text, kept so a reopened draft shows what
  /// was actually produced rather than regenerating something different.
  draftText         String?
  /// Bumped on every confirmed edit, so a PDF is never rendered from
  /// data the user has since changed.
  draftVersion      Int            @default(0)
  language          String         @default("en")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  case              Case?          @relation(fields: [caseId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  validation        FIRValidation?

  @@index([userId])
  @@index([caseId])
}

model FIRValidation {
  id                String   @id @default(uuid())
  firDraftId        String   @unique
  missingFields     String[]
  inconsistencies   String[]
  completenessScore Int
  createdAt         DateTime @default(now())
  firDraft          FIRDraft @relation(fields: [firDraftId], references: [id], onDelete: Cascade)
}

model LawyerReferral {
  id        String         @id @default(uuid())
  /// Nullable: a user can ask for legal-aid guidance before they have
  /// created a case for the matter at all.
  caseId    String?
  userId    String
  reason    ReferralReason
  category  String         @default("GENERAL")
  notes     String?
  status    ReferralStatus @default(SUBMITTED)
  createdAt DateTime       @default(now())
  case      Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([userId])
}

enum ReferralStatus {
  SUBMITTED
  ACKNOWLEDGED
  CLOSED
}

/// A verified point of contact for free/official legal help. Every row
/// traces to an actual government page — sourceUrl is not decorative,
/// it is how a user (or a judge reviewing this project) can confirm
/// the number is real rather than invented for the demo.
model LegalAidResource {
  id          String   @id @default(uuid())
  name        String
  category    String
  phone       String?
  description String
  website     String?
  sourceUrl   String
  /// Order within its category, lower first. Lets "Emergency" and
  /// "NALSA" lead their sections without relying on insertion order.
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([category])
}

/// A section a user has deliberately kept, with an optional note —
/// the actual "saved" in Saved Sources, as opposed to the full library
/// list that was there before and is not personal to anyone.
model SavedSource {
  id            String      @id @default(uuid())
  userId        String
  legalSourceId String
  /// Which section within the Act, if the save is that specific.
  section       String?
  note          String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalSource   LegalSource @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)

  @@unique([userId, legalSourceId, section])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  messageId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  message   Message? @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

enum Role {
  USER
  ADMIN
  RESEARCHER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EvidenceLevel {
  STRONG
  MODERATE
  LIMITED
  INSUFFICIENT
}

enum DocumentStatus {
  UPLOADED
  VALIDATING
  EXTRACTING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

enum DocumentType {
  PDF
  DOCX
  TXT
  IMAGE
}

enum SourceType {
  STATUTE
  JUDGMENT
  NOTIFICATION
  GOVERNMENT_CIRCULAR
  OTHER_VERIFIED
}

enum VerificationStatus {
  VERIFIED
  PENDING_REVIEW
  UNVERIFIED
}

enum FIRStatus {
  DRAFT
  VALIDATED
  FINALIZED
}

enum ReferralReason {
  LOW_CONFIDENCE
  HIGH_RISK
  USER_REQUESTED
  REQUIRES_REPRESENTATION
}

enum NotificationType {
  SYSTEM
  CASE_UPDATE
  DOCUMENT_READY
  FIR_READY
  SECURITY
}

/// Runtime translation cache.
/// LegalSetu ships no per-language locale files — every string is
/// translated on demand and stored here, so a string translated
/// once is free for every user afterwards.
model TranslationCache {
  id             String   @id @default(uuid())
  sourceHash     String
  targetLang     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([sourceHash, targetLang])
  @@index([targetLang])
}

/// Durable, user-scoped memory — the thing that makes LegalSetu feel
/// continuous instead of amnesiac between conversations.
///
/// Deliberately small and readable: each row is one short sentence in
/// plain language, not a transcript. That matters here more than in a
/// general assistant, because these can describe someone's assault,
/// eviction or debt. A user must be able to look at exactly what is
/// remembered about them and delete any of it, which is only possible
/// if it is stored as legible text rather than an opaque embedding.
model UserMemory {
  id        String   @id @default(uuid())
  userId    String
  /// One fact, in plain language. e.g. "Lives in Ghaziabad, UP."
  content   String
  /// Rough grouping so the UI can show these in sensible sections and
  /// the retriever can prefer durable facts over one-off details.
  category  String   @default("general")
  /// Where it came from, so a user can trace a memory to the chat that
  /// produced it. Nulled rather than cascaded if that chat is deleted —
  /// deleting a conversation should not silently erase what was learned.
  sourceConversationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time passcodes for email verification and password reset.
/// Codes are stored hashed (never plaintext) since this table is a
/// direct route to taking over an account if it ever leaked.
model OtpCode {
  id          String    @id @default(uuid())
  /// Keyed by email, not userId — needed during registration before
  /// the account row (and its id) exists yet.
  email       String
  codeHash    String
  purpose     OtpPurpose
  /// Failed verification attempts against this code. Capped so a
  /// 6-digit code cannot be brute-forced within its lifetime.
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, purpose])
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
